# ==============================================================================
# Nepal River Basin Flood Early Warning Bot - Environment Configuration
# 100% Free Tier Setup ($0 Cost Production Deployment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT TOKEN (100% Free)
# ------------------------------------------------------------------------------
# How to get:
#   1. Open Telegram and search for "@BotFather" (verified bot with blue checkmark).
#   2. Send "/newbot" and follow the prompts to name your bot (e.g. NepalFloodAlertBot).
#   3. BotFather will provide an HTTP API token (format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ).
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRstuVWXyz_EXAMPLE"

# ------------------------------------------------------------------------------
# 2. TELEGRAM CHANNEL OR GROUP ID (100% Free)
# ------------------------------------------------------------------------------
# How to get:
#   1. Create a public or private Telegram Channel (e.g., "Nepal Flood Alerts").
#   2. Add your newly created bot as an ADMINISTRATOR with "Post Messages" permission.
#   3. For public channels, use your @channel_username (e.g., "@nepal_flood_alerts").
#   4. For private channels/groups, forward any message from the channel to "@userinfobot"
#      or "@RawDataBot" to get the numeric ID (starts with -100, e.g., "-1001234567890").
TELEGRAM_CHAT_ID="@your_flood_alerts_channel_or_chat_id"

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI FLASH API KEY (100% Free Tier)
# ------------------------------------------------------------------------------
# How to get:
#   1. Go to Google AI Studio: https://aistudio.google.com/
#   2. Sign in with your Google account.
#   3. Click "Get API key" -> "Create API key in new project".
#   4. Free tier provides 15 requests/minute (RPM) and 1,500 requests/day, which is
#      more than 10x what this bot needs for 15-minute polling cycles!
# Note: If left blank or exhausted, the bot automatically falls back to its built-in
# verified bilingual disaster template engine without crashing.
GEMINI_API_KEY="AIzaSyYourFreeGeminiKeyFromGoogleAIStudio"

# ------------------------------------------------------------------------------
# 4. SYSTEM & ALERT FATIGUE SETTINGS
# ------------------------------------------------------------------------------
# Cooldown window in minutes for repeat alerts at the same severity level.
# Prevents spamming subscribers while the river remains above danger level.
# Escalations (e.g. WARNING -> EMERGENCY) bypass this cooldown immediately.
ALERT_COOLDOWN_MINUTES="120"

# Set to "true" to force deterministic realistic mock data (useful for offline testing / CI)
USE_MOCK_DATA="false"
